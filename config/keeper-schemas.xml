  <ProvisioningForms>
    <Form name="Keeper Create Account" objectType="account" type="Create">
      <Attributes>
        <Map>
          <entry key="pageTitle" value="Keeper Create Account"/>
        </Map>
      </Attributes>
      <Section name="Keeper Account">
        <Field displayName="Email" helpKey="Primary email; becomes the Keeper login" name="email" required="true" type="string">
          <Script>
            <Source>return identity == null ? null : identity.getEmail();</Source>
          </Script>
        </Field>
        <Field displayName="Name" helpKey="Display name in Keeper" name="name" required="true" type="string">
          <Script>
            <Source>return identity == null ? null : identity.getDisplayName();</Source>
          </Script>
        </Field>
        <Field displayName="Job Title" name="jobTitle" type="string"/>
        <Field displayName="Node" helpKey="Keeper enterprise node the user is placed in" name="node" required="true" type="string">
          <AllowedValuesDefinition>
            <Script>
              <Source>
                import java.util.ArrayList;
                import java.util.List;
                import sailpoint.object.Filter;
                import sailpoint.object.ManagedAttribute;
                import sailpoint.object.QueryOptions;

                QueryOptions qo = new QueryOptions();
                qo.addFilter(Filter.eq("application.name", application.getName()));
                qo.addFilter(Filter.eq("type", "node"));
                qo.setOrderBy("displayName");
                List values = new ArrayList();
                for (ManagedAttribute node : context.getObjects(ManagedAttribute.class, qo)) {
                    List pair = new ArrayList();
                    pair.add(node.getValue());
                    pair.add(node.getDisplayableName());
                    values.add(pair);
                }
                return values;
              </Source>
            </Script>
          </AllowedValuesDefinition>
          <Script>
            <Source>
              import sailpoint.object.Filter;
              import sailpoint.object.ManagedAttribute;
              import sailpoint.object.QueryOptions;

              // Default to the enterprise root node (the node without a parent).
              QueryOptions qo = new QueryOptions();
              qo.addFilter(Filter.eq("application.name", application.getName()));
              qo.addFilter(Filter.eq("type", "node"));
              for (ManagedAttribute node : context.getObjects(ManagedAttribute.class, qo)) {
                  if (node.getAttribute("parentId") == null) {
                      return node.getValue();
                  }
              }
              return null;
            </Source>
          </Script>
        </Field>
      </Section>
    </Form>
  </ProvisioningForms>
